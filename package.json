{
  "name": "dao-optimistic-backend",
  "version": "2.0.0",
  "description": "Simple Optimistic UI Backend - Figma/Miro Style (Refactored)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" src/server.js",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker-compose.yml down",
    "docker:logs": "docker-compose -f docker-compose.yml logs -f",
    "docker:build": "docker-compose -f docker-compose.yml build",
    "test": "node --test \"src/**/*.test.js\"",
    "test:snapshots": "node test-snapshots.js",
    "journal": "node --env-file-if-exists=.env scripts/journal.js"
  },
  "keywords": [
    "optimistic-ui",
    "websocket",
    "redis",
    "real-time",
    "collaboration"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "cors": "^2.8.5",
    "cron": "^3.1.6",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "node-fetch": "^3.3.2",
    "uuid": "^9.0.1",
    "ws": "^8.14.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
