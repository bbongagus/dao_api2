# Server Configuration
PORT=3001
NODE_ENV=development

# Redis Configuration (Local Development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis URL (Railway/Production - Railway will auto-provide this)
# REDIS_URL=redis://default:password@host:port
# REDIS_PRIVATE_URL=redis://default:password@host:port (Railway internal)

# Authentication. The server trusts exactly one issuer and does not start without one.
# Production (Railway variables): the Auth0 tenant.
# AUTH0_DOMAIN=dev-fw7tvujf5ywhjbi3.us.auth0.com
# Locally: npm run auth:dev-keys appends AUTH_DEV_PUBLIC_KEY and AUTH_DEV_PRIVATE_KEY
# to .env; npm run token -- <userId> [--days N] signs a token with the private one.
AUTH_AUDIENCE=https://dao-api

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:5174

# AI planning - graph generation from the ai-magic button.
# Without this the endpoint replies with a clear error instead of a plan.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model. Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# App URL
APP_URL=http://localhost:3001
